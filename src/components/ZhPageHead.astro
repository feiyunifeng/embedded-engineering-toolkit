---
const { eyebrow = '工程参考', title, intro, crumbs = [] } = Astro.props;
---
<header class="page-head"><div class="container"><nav class="breadcrumbs" aria-label="面包屑"><a href="/zh/">首页</a>{crumbs.map((c:any)=><><span> / </span><a href={c.url}>{c.name}</a></>)}</nav><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p class="prose">{intro}</p></div></header>
