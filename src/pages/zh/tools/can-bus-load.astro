---
import Base from '../../../layouts/ZhBaseLayout.astro';import Head from '../../../components/ZhPageHead.astro';import ZhToolContent from '../../../components/ZhToolContent.astro';import AdSlot from '../../../components/AdSlot.astro';
const faqs=[{q:'结果是精确的吗？',a:'不是。仲裁、错误帧、重传、时钟容差和实际填充模式都会改变利用率。'},{q:'为什么有两个估算？',a:'无填充值是基线，保守值增加 20% 作为规划余量。'},{q:'支持 CAN FD 吗？',a:'不支持。本工具只模拟数据长度 0 到 8 字节的 Classical CAN。'}];
---
<Base title="CAN 总线负载计算器" description="使用无填充和保守填充假设估算 Classical CAN 帧时间与总线利用率。" enPath="/tools/can-bus-load/"><Head eyebrow="Classical CAN 计算器" title="CAN 总线负载计算器" intro="使用透明的 11 位和 29 位标识符估算规划 Classical CAN 容量。" crumbs={[{name:'全部工具',url:'/zh/tools/'}]}/><section class="container content"><div class="tool-layout"><form class="calculator" id="can-form" novalidate><h2>流量模型</h2><div class="form-grid"><div class="field"><label for="can-format">标识符格式</label><select id="can-format"><option value="standard">CAN 2.0A — 11 位</option><option value="extended">CAN 2.0B — 29 位</option></select></div><div class="field"><label for="can-rate">比特率（bit/s）</label><input id="can-rate" type="number" min="1" step="1" value="500000" required></div><div class="field"><label for="can-dlc">数据长度（字节）</label><input id="can-dlc" type="number" min="0" max="8" step="1" value="8" required></div><div class="field"><label for="can-mps">每秒消息数</label><input id="can-mps" type="number" min="0" step="any" value="1000" required></div><div class="field"><label for="can-count">相同消息数量</label><input id="can-count" type="number" min="0" step="1" value="1" required></div></div><div class="actions"><button class="button" type="submit">计算</button><button class="button secondary" type="button" id="can-example">加载扩展帧案例</button></div><p class="error sr-status" id="can-error" role="alert"></p></form><section class="result" aria-live="polite"><h2>估算结果</h2><dl><dt>无填充帧长度</dt><dd id="can-base">—</dd><dt>保守帧长度</dt><dd id="can-stuffed">—</dd><dt>无填充帧时间</dt><dd id="can-time">—</dd><dt>保守帧时间</dt><dd id="can-stuffed-time">—</dd><dt>无填充总线负载</dt><dd id="can-load">—</dd><dt>保守总线负载</dt><dd id="can-conservative">—</dd><dt>剩余容量</dt><dd id="can-remaining">—</dd></dl><p id="can-warning" class="warning"></p></section></div><AdSlot/><ZhToolContent name="CAN 总线负载计算器" formula="标准帧使用 47 个基准位，扩展帧使用 67 个基准位（均含 3-bit intermission），再加每字节 8 位。负载 = 帧位数 × 每秒消息数 × 消息数量 ÷ 比特率 × 100%。保守值为帧长度 × 1.20 后向上取整。" example="500 kbit/s、11 位标识符、8 字节、1000 帧/s 的案例为 111 bit、22.2%；向上取整的 134 bit 保守估算为 26.8%。" mistakes={['把规划余量当成严格最坏帧长度。','忽略优先级、重传、错误帧或诊断突发。','把 Classical CAN 算式用于 CAN FD。']} faqs={faqs} related={[{name:'如何估算 CAN 总线负载',url:'/zh/guides/can-bus-load/'},{name:'UART 传输时间计算器',url:'/zh/tools/uart-transmission-time/'}]}/></section><script is:inline src="/scripts/can-ui.js"></script></Base>
