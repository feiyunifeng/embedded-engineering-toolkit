---
import Base from '../../../layouts/ZhBaseLayout.astro';import Head from '../../../components/ZhPageHead.astro';import ZhToolContent from '../../../components/ZhToolContent.astro';import AdSlot from '../../../components/AdSlot.astro';
const faqs=[{q:'为什么 PSC 和 ARR 要加一？',a:'STM32 分频器和计数器采用从零开始的寄存器值，0 代表一个时钟步长。'},{q:'APB 分频会影响定时器时钟吗？',a:'许多 STM32 系列在 APB 分频不为 1 时会对定时器时钟倍频，请使用具体芯片文档中的有效输入时钟。'},{q:'为什么偏好较大的 ARR？',a:'较大的 ARR 提供更多比较步数，可提高占空比分辨率。'}];
---
<Base title="STM32 定时器与 PWM 计算器" description="计算 STM32 计数器时钟、定时器周期、PWM 频率、占空比并求解 PSC/ARR。" enPath="/tools/stm32-timer-pwm/"><Head eyebrow="STM32 计算器" title="STM32 定时器与 PWM 计算器" intro="将定时器寄存器转换为频率和占空比，也可以为目标 PWM 频率寻找 PSC/ARR。" crumbs={[{name:'全部工具',url:'/zh/tools/'}]}/><section class="container content"><div class="tool-layout"><form class="calculator" id="timer-form" novalidate><h2>定时器寄存器</h2><div class="form-grid"><div class="field"><label for="timer-clock">定时器输入时钟（Hz）</label><input id="timer-clock" type="number" min="1" step="any" value="72000000" required></div><div class="field"><label for="timer-width">定时器位宽</label><select id="timer-width"><option value="16">16 位</option><option value="32">32 位</option></select></div><div class="field"><label for="timer-psc">预分频器（PSC）</label><input id="timer-psc" type="number" min="0" step="1" value="71" required></div><div class="field"><label for="timer-arr">自动重载（ARR）</label><input id="timer-arr" type="number" min="0" step="1" value="999" required></div><div class="field"><label for="timer-ccr">捕获/比较（CCR）</label><input id="timer-ccr" type="number" min="0" step="1" value="250" required></div></div><div class="actions"><button class="button" type="submit">计算</button></div><p class="error sr-status" id="timer-error" role="alert"></p><hr><h2>目标频率求解器</h2><div class="field"><label for="timer-target">目标 PWM 频率（Hz）</label><input id="timer-target" type="number" min="1" step="any" value="1000"></div><div class="actions"><button class="button secondary" type="button" id="timer-solve">寻找 PSC 和 ARR</button></div></form><section class="result" aria-live="polite"><h2>计算结果</h2><dl><dt>计数器时钟</dt><dd id="timer-counter">—</dd><dt>定时器周期</dt><dd id="timer-period">—</dd><dt>PWM 频率</dt><dd id="timer-frequency">—</dd><dt>占空比</dt><dd id="timer-duty">—</dd><dt>寄存器校验</dt><dd id="timer-valid">—</dd></dl><h3>求解结果</h3><dl><dt>PSC</dt><dd id="solve-psc">—</dd><dt>ARR</dt><dd id="solve-arr">—</dd><dt>实际频率</dt><dd id="solve-frequency">—</dd><dt>误差</dt><dd id="solve-error">—</dd></dl></section></div><AdSlot/><ZhToolContent name="STM32 定时器计算器" formula="计数器时钟 = 定时器时钟 ÷ (PSC + 1)；PWM 频率 = 定时器时钟 ÷ ((PSC + 1) × (ARR + 1))；边沿对齐占空比 = CCR ÷ (ARR + 1) × 100%。" example="72 MHz、PSC=71、ARR=999、CCR=250 时，计数器为 1 MHz，PWM 为 1 kHz，占空比为 25%。" mistakes={['把 APB 外设时钟直接当作定时器输入。','忘记 PSC 和 ARR 的 +1。','让 CCR 超出 ARR 的有效范围。']} faqs={faqs} related={[{name:'STM32 定时器时钟与 PWM 公式',url:'/zh/guides/stm32-timer-pwm/'},{name:'UART 传输时间计算器',url:'/zh/tools/uart-transmission-time/'}]}/></section><script is:inline src="/scripts/timer-ui.js"></script></Base>
