---
import Base from '../../../layouts/ZhBaseLayout.astro';import Head from '../../../components/ZhPageHead.astro';import ZhToolContent from '../../../components/ZhToolContent.astro';import AdSlot from '../../../components/AdSlot.astro';
const faqs=[{q:'波特率等于有效载荷速率吗？',a:'不等于。起始、奇偶校验和停止位占用线路时间，因此有效吞吐量更低。'},{q:'为什么假设一个起始位？',a:'常见异步 UART 帧使用一个起始位，本计算器采用这种格式。'},{q:'UART 可以使用 1.5 个停止位吗？',a:'部分 UART 支持。使用前请确认两端均支持。'}];
---
<Base title="UART 传输时间计算器" description="根据波特率、字节数、数据位、奇偶校验和停止位计算 UART 帧位数、传输时间和有效吞吐量。" enPath="/tools/uart-transmission-time/"><Head eyebrow="UART 计算器" title="UART 传输时间计算器" intro="估算异步串行传输占用线路的时间，包括起始、奇偶校验和停止位。" crumbs={[{name:'全部工具',url:'/zh/tools/'}]}/><section class="container content"><div class="tool-layout"><form class="calculator" id="uart-form" novalidate><h2>帧设置</h2><div class="form-grid"><div class="field"><label for="uart-baud">波特率（bit/s）</label><input id="uart-baud" type="number" min="1" step="1" value="115200" required></div><div class="field"><label for="uart-bytes">字节数</label><input id="uart-bytes" type="number" min="0" step="1" value="100" required></div><div class="field"><label for="uart-data">数据位</label><select id="uart-data"><option>5</option><option>6</option><option>7</option><option selected>8</option><option>9</option></select></div><div class="field"><label for="uart-parity">奇偶校验</label><select id="uart-parity"><option value="none">无</option><option value="even">偶校验</option><option value="odd">奇校验</option></select></div><div class="field"><label for="uart-stop">停止位</label><select id="uart-stop"><option value="1">1</option><option value="1.5">1.5</option><option value="2">2</option></select></div></div><div class="actions"><button class="button" type="submit">计算</button><button class="button secondary" type="button" id="uart-example">加载 9600 波特率案例</button></div><p class="error sr-status" id="uart-error" role="alert"></p></form><section class="result" aria-live="polite"><h2>估算结果</h2><dl><dt>每帧位数</dt><dd id="uart-frame">—</dd><dt>传输总位数</dt><dd id="uart-total">—</dd><dt>传输时间</dt><dd id="uart-time">—</dd><dt>有效载荷吞吐量</dt><dd id="uart-throughput">—</dd></dl><h3>公式</h3><div class="formula">每帧位数 = 1 + 数据位 + 奇偶位 + 停止位<br>时间 = 总位数 ÷ 波特率</div></section></div><AdSlot/><ZhToolContent name="UART 计算器" formula="每帧位数 = 1 + 数据位 + 奇偶位 + 停止位；总位数 = 每帧位数 × 字节数；传输时间 = 总位数 ÷ 波特率。吞吐量按每字节 8 个有效载荷位计算。" example="115200 baud 下，100 字节 8N1 使用 10 bit/frame 和 1000 bit，传输约需 8.681 ms，有效吞吐量为 92,160 bit/s。" mistakes={['只数八个数据位而忽略帧开销。','把波特率和字节每秒混淆。','以为线路时间包含软件延迟、缓冲或流控。']} faqs={faqs} related={[{name:'理解 UART 帧时间',url:'/zh/guides/uart-frame-time/'},{name:'CAN 总线负载计算器',url:'/zh/tools/can-bus-load/'}]}/></section><script is:inline src="/scripts/uart-ui.js"></script></Base>
