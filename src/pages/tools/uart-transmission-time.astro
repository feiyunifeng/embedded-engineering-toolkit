---
import Base from '../../layouts/BaseLayout.astro';import Head from '../../components/PageHead.astro';import ToolContent from '../../components/ToolContent.astro';import AdSlot from '../../components/AdSlot.astro';
const faqs=[{q:'Does baud rate equal payload bit rate?',a:'No. Start, parity, and stop bits consume line time, so payload throughput is lower than the baud rate.'},{q:'Why is one start bit assumed?',a:'Conventional asynchronous UART frames use one start bit. This calculator models that common format.'},{q:'Can a UART use 1.5 stop bits?',a:'Some UART modes support it. Confirm support in both endpoints before using that selection.'}];
---
<Base title="UART Transmission Time Calculator" description="Calculate UART frame bits, transmission time, and effective payload throughput from baud rate, byte count, data bits, parity, and stop bits." crumbs={[{name:'All Tools',url:'/tools/'},{name:'UART Calculator',url:'/tools/uart-transmission-time/'}]}><Head eyebrow="UART calculator" title="UART Transmission Time Calculator" intro="Estimate how long an asynchronous serial transfer occupies the wire, including start, parity, and stop-bit overhead." crumbs={[{name:'All Tools',url:'/tools/'}]}/><section class="container content"><div class="tool-layout"><form class="calculator" id="uart-form" novalidate><h2>Frame settings</h2><div class="form-grid"><div class="field"><label for="uart-baud">Baud rate (bit/s)</label><input id="uart-baud" name="baud" type="number" min="1" step="1" inputmode="numeric" value="115200" required></div><div class="field"><label for="uart-bytes">Number of bytes</label><input id="uart-bytes" name="bytes" type="number" min="0" step="1" inputmode="numeric" value="100" required></div><div class="field"><label for="uart-data">Data bits</label><select id="uart-data" name="data"><option>5</option><option>6</option><option>7</option><option selected>8</option><option>9</option></select></div><div class="field"><label for="uart-parity">Parity</label><select id="uart-parity" name="parity"><option value="none">None</option><option value="even">Even</option><option value="odd">Odd</option></select></div><div class="field"><label for="uart-stop">Stop bits</label><select id="uart-stop" name="stop"><option value="1">1</option><option value="1.5">1.5</option><option value="2">2</option></select></div></div><div class="actions"><button class="button" type="submit">Calculate</button><button class="button secondary" type="button" id="uart-example">Load 9,600 baud example</button></div><p class="error sr-status" id="uart-error" role="alert"></p></form><section class="result" aria-live="polite"><h2>Estimated result</h2><dl><dt>Bits per frame</dt><dd id="uart-frame">—</dd><dt>Total transmitted bits</dt><dd id="uart-total">—</dd><dt>Transmission time</dt><dd id="uart-time">—</dd><dt>Payload throughput</dt><dd id="uart-throughput">—</dd></dl><h3>Formula</h3><div class="formula">bits/frame = 1 + data + parity + stop<br>time = total bits ÷ baud rate</div></section></div><AdSlot/><ToolContent name="The UART calculator" formula="One start bit is added to the selected data bits, an optional parity bit, and the selected stop-bit duration. Bits per frame = 1 + data bits + parity bit + stop bits. Total bits = frame bits × number of bytes. Transmission time = total bits ÷ baud rate. The throughput result treats each entered byte as eight useful payload bits." example="At 115,200 baud, 100 bytes in 8-N-1 framing use 10 bits per frame and 1,000 line bits. The transfer takes about 8.681 ms, while useful payload throughput is 92,160 bit/s." mistakes={['Counting only eight data bits and ignoring framing overhead.','Confusing baud rate with bytes per second.','Assuming software latency, buffering, or flow control is included in wire time.','Selecting a frame format that the remote endpoint does not support.']} faqs={faqs} related={[{name:'Understanding UART Frame Time',url:'/guides/uart-frame-time/'},{name:'CAN Bus Load Calculator',url:'/tools/can-bus-load/'}]}/></section><script is:inline src="/scripts/uart-ui.js"></script></Base>
