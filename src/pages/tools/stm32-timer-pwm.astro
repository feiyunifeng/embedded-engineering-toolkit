---
import Base from '../../layouts/BaseLayout.astro';import Head from '../../components/PageHead.astro';import ToolContent from '../../components/ToolContent.astro';import AdSlot from '../../components/AdSlot.astro';const faqs=[{q:'Why are PSC and ARR increased by one?',a:'STM32 timer dividers and counters encode a zero-based value: a register value of zero represents one clock step.'},{q:'Does APB prescaling affect the timer clock?',a:'On many STM32 families, a timer clock may be multiplied when the APB prescaler is not one. Use the effective timer input clock documented for your device.'},{q:'Why prefer a larger ARR?',a:'A larger ARR provides more discrete compare values, which improves PWM duty-cycle resolution.'}];
---
<Base title="STM32 Timer and PWM Calculator" description="Calculate STM32 counter clock, timer period, PWM frequency, duty cycle, register validity, and solve PSC/ARR for a target frequency."><Head eyebrow="STM32 calculator" title="STM32 Timer and PWM Calculator" intro="Translate timer registers into frequency and duty cycle, or find a practical PSC/ARR pair for a target PWM frequency." crumbs={[{name:'All Tools',url:'/tools/'}]}/><section class="container content"><div class="tool-layout"><form class="calculator" id="timer-form" novalidate><h2>Timer registers</h2><div class="form-grid"><div class="field"><label for="timer-clock">Timer input clock (Hz)</label><input id="timer-clock" type="number" min="1" step="any" value="72000000" required></div><div class="field"><label for="timer-width">Timer width</label><select id="timer-width"><option value="16">16-bit</option><option value="32">32-bit</option></select></div><div class="field"><label for="timer-psc">Prescaler (PSC)</label><input id="timer-psc" type="number" min="0" step="1" value="71" required></div><div class="field"><label for="timer-arr">Auto-reload (ARR)</label><input id="timer-arr" type="number" min="0" step="1" value="999" required></div><div class="field"><label for="timer-ccr">Capture/compare (CCR)</label><input id="timer-ccr" type="number" min="0" step="1" value="500" required></div></div><div class="actions"><button class="button" type="submit">Calculate</button></div><p class="error sr-status" id="timer-error" role="alert"></p><hr><h2>Target Frequency Solver</h2><div class="field"><label for="timer-target">Target PWM frequency (Hz)</label><input id="timer-target" type="number" min="1" step="any" value="1000"></div><div class="actions"><button class="button secondary" type="button" id="timer-solve">Find PSC and ARR</button></div></form><section class="result" aria-live="polite"><h2>Calculated timer</h2><dl><dt>Counter clock</dt><dd id="timer-counter">—</dd><dt>Timer period</dt><dd id="timer-period">—</dd><dt>PWM frequency</dt><dd id="timer-frequency">—</dd><dt>Duty cycle</dt><dd id="timer-duty">—</dd><dt>Register validation</dt><dd id="timer-valid">—</dd></dl><h3>Solver result</h3><dl><dt>PSC</dt><dd id="solve-psc">—</dd><dt>ARR</dt><dd id="solve-arr">—</dd><dt>Actual frequency</dt><dd id="solve-frequency">—</dd><dt>Error</dt><dd id="solve-error">—</dd></dl></section></div><AdSlot/><ToolContent name="The STM32 timer calculator" formula="Counter clock = timer clock ÷ (PSC + 1). PWM frequency = timer clock ÷ ((PSC + 1) × (ARR + 1)). Edge-aligned PWM duty cycle = CCR ÷ (ARR + 1) × 100%. The solver searches valid integer registers, minimizes frequency error, and breaks equal-error ties in favor of the larger ARR." example="With a 72 MHz timer clock, PSC = 71 and ARR = 999, the counter runs at 1 MHz and PWM runs at 1 kHz. CCR = 500 produces a 50% computed duty cycle." mistakes={['Using the APB peripheral clock when the timer receives a different effective clock.','Forgetting the +1 applied to PSC and ARR.','Entering a CCR value outside the useful range for the selected ARR.','Assuming every STM32 timer has the same register width or operating mode.']} faqs={faqs} related={[{name:'STM32 Timer Clock and PWM Formula Explained',url:'/guides/stm32-timer-pwm/'},{name:'UART Transmission Time Calculator',url:'/tools/uart-transmission-time/'}]}/></section><script is:inline src="/scripts/timer-ui.js"></script></Base>
