---
import Base from '../layouts/BaseLayout.astro';import ToolCard from '../components/ToolCard.astro';import AdSlot from '../components/AdSlot.astro';import {siteConfig} from '../config/site';
---
<Base title="Embedded Systems Calculators" description="Free, browser-based UART, CAN bus, and STM32 timer calculators with formulas, examples, and practical engineering guidance."><section class="hero"><div class="container"><div class="eyebrow">Fast • transparent • local</div><h1>Practical calculations for embedded design decisions.</h1><p>{siteConfig.tagline} Every result shows its assumptions, and every calculation runs privately in your browser.</p><a class="button" href="/tools/">Explore all tools</a></div></section><section class="container content"><h2>Start with a calculator</h2><div class="grid"><ToolCard href="/tools/uart-transmission-time/" label="Serial" title="UART Transmission Time" text="Turn baud rate and frame settings into transfer time and effective payload throughput."/><ToolCard href="/tools/can-bus-load/" label="Automotive & industrial" title="CAN Bus Load" text="Compare Classical CAN utilization with and without a conservative stuffing allowance."/><ToolCard href="/tools/stm32-timer-pwm/" label="Microcontrollers" title="STM32 Timer & PWM" text="Calculate timer frequency, duty cycle, and practical PSC/ARR values for a target PWM."/></div><AdSlot/><div class="grid"><div class="card"><h2>Know the formula</h2><p>Results include equations and defined assumptions so you can review the arithmetic instead of trusting a black box.</p></div><div class="card"><h2>Designed for the bench</h2><p>Responsive forms, clear units, keyboard-friendly controls, and readable results make quick checks straightforward.</p></div><div class="card"><h2>Learn as you calculate</h2><p>Focused guides explain why framing overhead, CAN stuffing, and timer register semantics change real designs.</p></div></div></section></Base>
