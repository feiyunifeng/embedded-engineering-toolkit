---
import '../styles/global.css';
import { siteConfig } from '../config/site';
const { title, description, crumbs = [], lang = 'en', zhPath, enPath: explicitEnPath } = Astro.props;
const pathname = Astro.url.pathname;
const enPath = explicitEnPath ?? (pathname.startsWith('/zh/') ? pathname.slice(3) || '/' : pathname);
const chinesePath = zhPath ?? `/zh${enPath === '/' ? '/' : enPath}`;
const canonical = new URL(pathname, siteConfig.url);
const fullTitle = `${title} | ${siteConfig.name}`;
const bc = [{ name: lang === 'zh-Hans' ? '首页' : 'Home', url: lang === 'zh-Hans' ? '/zh/' : '/' }, ...crumbs];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-site-verification" content="n4dSIra2LblUp2rRhHoIxgLafl3UYyzzqLmaxlMvmIM" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteConfig.url)} />
    <link rel="alternate" hreflang="zh-Hans" href={new URL(chinesePath, siteConfig.url)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, siteConfig.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.svg', siteConfig.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#071a2b" />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',inLanguage:lang,itemListElement:bc.map((x:any,i:number)=>({'@type':'ListItem',position:i+1,name:x.name,item:new URL(x.url,siteConfig.url).href}))})} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header"><div class="container nav"><a class="brand" href="/">{siteConfig.name}<span>{siteConfig.tagline}</span></a><nav class="nav-links" aria-label="Primary"><a href="/tools/">All Tools</a><a href="/guides/uart-frame-time/">Guides</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav><nav class="language-switch" aria-label="Language"><a href={chinesePath}>简体中文</a><a href={enPath}>English</a></nav></div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid"><div><strong>{siteConfig.name}</strong><p>{siteConfig.tagline}</p><small>Independent educational tools. Verify results against your device documentation.</small></div><div><strong>Resources</strong><ul><li><a href="/tools/">All Tools</a></li><li><a href="/about/">About</a></li><li><a href="/contact/">Contact</a></li></ul></div><div><strong>Legal</strong><ul><li><a href="/privacy/">Privacy Policy</a></li><li><a href="/terms/">Terms of Use</a></li><li><a href="/disclaimer/">Engineering Disclaimer</a></li></ul></div></div></footer>
  </body>
</html>
